    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Suppress repeated alerts for the same incident within a time window\nconst staticData = $getWorkflowStaticData('global');\nconst raw = $input.item.json;\nconst body = raw.body ? raw.body : raw;\nconst incidentId = body.incidentId || body.incident_id || 'UNKNOWN';\nconst severity = (body.severity || 'INFO').toString().toUpperCase();\nconst key = severity + ':' + incidentId;\nconst now = Date.now();\nconst windowMs = 5 * 60 * 1000; // 5-minute throttle window\nstaticData.lastAlerts = staticData.lastAlerts || {};\nconst last = staticData.lastAlerts[key];\nlet suppressed = false;\nif (last && (now - last) < windowMs) {\n  suppressed = true;\n} else {\n  staticData.lastAlerts[key] = now;\n}\nreturn {\n  json: {\n    incidentId,\n    severity,\n    message: body.message || 'No message provided',\n    acknowledged: body.acknowledged === true,\n    onCallPhone: body.onCallPhone || body.phone || '',\n    throttleKey: key,\n    suppressed,\n    timestamp: new Date(now).toISOString(),\n  },\n};"
      },
      "id": "ef5aa620-3138-41a9-920d-b673d44a50fb",
      "name": "Alert Throttle Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
